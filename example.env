# DB things
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# /api/* origin allowlist (anti-scrape gate in middleware.ts)
# AUTH_URL is allowed automatically. Use these for additional origins.
# Comma-separated exact origins (e.g. https://www.vdc.gg,http://localhost:3000)
ALLOWED_API_ORIGINS=
# Comma-separated host suffixes for wildcard matching (e.g. .vercel.app)
ALLOWED_API_ORIGIN_SUFFIXES=

# Ghost
GHOST_API_KEY=

# Google
GOOGLE_API_KEY=

#Meilisearch
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
NEXT_PUBLIC_MEILISEARCH_URL=

# pre-release
PREVIEW="fales"

# Riot
RIOT_CLIENT_ID=""
RIOT_CLIENT_SECRET=""