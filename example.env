# DB things
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Ghost
GHOST_API_KEY=

# Discord
DISCORD_BOT_TOKEN=
# VDC server id (same value as vdc-bot's SERVER_ID); unset skips the guild-profile lookup
DISCORD_GUILD_ID=

# Google
GOOGLE_API_KEY=

# Meilisearch (server-side only, never prefix these with NEXT_PUBLIC_)
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=

# Optional shared secret for the bot: sent as "Authorization: Bearer <secret>" to /api/internal/*
INTERNAL_API_SECRET=

# pre-release
PREVIEW="fales"

# Riot
RIOT_CLIENT_ID=""
RIOT_CLIENT_SECRET=""

# Twitch
TWITCH_CLIENT_ID= ""
TWITCH_CLIENT_SECRET= ""

# Cloudflare Turnstile secret for the signup captcha (the site key lives in SignUpForm)
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames the captcha may be solved on (e.g. vdc.gg). Unset skips the check.
TURNSTILE_HOSTNAMES=
